<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Every 2 hours: follow up open PRs, triage, advance one issue, notify what needs you.
     A template: bin/install-launchd.sh fills in __DIR__ and __PATH__ and loads it.
     Run once now:  launchctl kickstart gui/$(id -u)/dev.khanh.ossbot
     Stop:  bin/install-launchd.sh --uninstall
     bin/oss-bot-run.sh sources .env and skips the pass when Docker is not running. -->
<plist version="1.0"><dict>
  <key>Label</key><string>dev.khanh.ossbot</string>
  <key>WorkingDirectory</key><string>__DIR__</string>
  <key>ProgramArguments</key>
  <array><string>__DIR__/bin/oss-bot-run.sh</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>__PATH__</string></dict>
  <key>StartInterval</key><integer>7200</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__DIR__/data/launchd.log</string>
  <key>StandardErrorPath</key><string>__DIR__/data/launchd.log</string>
</dict></plist>
