<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Every 2 hours: follow up open PRs, triage, advance one issue, notify what needs you.
     Install:  cp launchd/dev.khanh.ossbot.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/dev.khanh.ossbot.plist
     Run once now:  launchctl kickstart gui/$(id -u)/dev.khanh.ossbot
     Stop:  launchctl unload ~/Library/LaunchAgents/dev.khanh.ossbot.plist
     bin/oss-bot-run.sh sets PATH, sources .env and skips the pass when Colima is not running. -->
<plist version="1.0"><dict>
  <key>Label</key><string>dev.khanh.ossbot</string>
  <key>WorkingDirectory</key><string>/Users/khanh.dinhn/Development/open-source/oss-bot</string>
  <key>ProgramArguments</key>
  <array><string>/Users/khanh.dinhn/Development/open-source/oss-bot/bin/oss-bot-run.sh</string></array>
  <key>StartInterval</key><integer>7200</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/khanh.dinhn/Development/open-source/oss-bot/data/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/khanh.dinhn/Development/open-source/oss-bot/data/launchd.log</string>
</dict></plist>
